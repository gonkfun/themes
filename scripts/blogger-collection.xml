<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'
      xmlns:data='http://www.google.com/2005/gml/data'
      xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <meta content='$background' name='theme-color'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>
  <b:if cond='not data:blog.metaDescription'>
    <b:if cond='data:blog.description'>
      <meta expr:content='data:blog.description' name='description'/>
    </b:if>
  </b:if>
  <meta expr:content='data:blog.title' property='og:site_name'/>
  <meta expr:content='data:blog.pageTitle' name='twitter:title'/>
  <b:if cond='data:blog.postImageUrl'>
    <meta content='summary_large_image' name='twitter:card'/>
    <meta expr:content='data:blog.postImageUrl' name='twitter:image'/>
  <b:else/>
    <meta content='summary' name='twitter:card'/>
  </b:if>
  <b:skin><![CDATA[
$styles
  ]]></b:skin>
</head>
<body class='gc-blogger'>
  <a class='gc-skip' href='#content'>Skip to content</a>
  <header class='gc-header'>
    <div class='gc-wrap'>
      <a class='gc-brand' expr:href='data:blog.homepageUrl'><data:blog.title/></a>
      <nav aria-label='Main navigation'>
        <a expr:href='data:blog.homepageUrl'>Home</a>
        <a expr:href='data:blog.homepageUrl + "#overview"'>$section</a>
        <a expr:href='data:blog.homepageUrl + "#updates"'>Posts</a>
      </nav>
    </div>
  </header>
  <main id='content' tabindex='-1'>
    <b:if cond='data:blog.url == data:blog.homepageUrl or data:blog.canonicalUrl == data:blog.homepageUrl'>
      $hero
      $overview
    </b:if>
    <b:if cond='data:blog.pageType != "item" and data:blog.pageType != "static_page"'>
      <form class='gc-wrap gc-blog-search' expr:action='data:blog.homepageUrl + "search"' method='get' role='search'>
        <label for='gc-search'>Search posts</label>
        <input id='gc-search' name='q' type='search'/>
        <button type='submit'>Search</button>
      </form>
    </b:if>
    <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
      <b:widget id='Blog1' locked='yes' mobile='yes' title='Blog Posts' type='Blog' version='1'>
        <b:includable id='main' var='top'>
          <b:if cond='data:blog.pageType == "item" or data:blog.pageType == "static_page"'>
            <b:loop values='data:posts' var='post'>
              <article class='gc-article'>
                <h1><data:post.title/></h1>
                <b:if cond='data:blog.pageType == "item"'>
                  <p class='gc-byline'><data:post.timestamp/> · <data:post.author/></p>
                </b:if>
                <div class='post-body entry-content' expr:id='"post-body-" + data:post.id'><data:post.body/></div>
                <b:include data='post' name='collectionLabels'/>
                <b:if cond='data:post.allowComments'>
                  <b:include data='post' name='collectionComments'/>
                </b:if>
              </article>
            </b:loop>
          <b:else/>
            <section class='gc-wrap gc-updates' id='updates'>
              <b:if cond='data:blog.url == data:blog.homepageUrl or data:blog.canonicalUrl == data:blog.homepageUrl'>
                <h2 class='gc-section-title'>$updates</h2>
              <b:else/>
                <h1 class='gc-section-title'>
                  <b:if cond='data:blog.searchLabel'>
                    <data:blog.searchLabel/>
                  <b:elseif cond='data:blog.searchQuery'/>
                    Search: <data:blog.searchQuery/>
                  <b:else/>
                    <data:blog.pageTitle/>
                  </b:if>
                </h1>
              </b:if>
              <div class='gc-update-grid'>
                <b:loop values='data:posts' var='post'>
                  <article class='gc-item'>
                    <b:if cond='data:post.firstImageUrl'>
                      <img alt='' expr:src='data:post.firstImageUrl' height='450' loading='lazy' width='600'/>
                    </b:if>
                    <h3><a expr:href='data:post.url'><data:post.title/></a></h3>
                    <p class='gc-byline'><data:post.timestamp/></p>
                    <p><b:eval expr='snippet(data:post.body, {length: 145, links: false, linebreaks: false})'/></p>
                    <b:include data='post' name='collectionLabels'/>
                  </article>
                </b:loop>
              </div>
              <b:if cond='data:posts.empty'><p>No matching posts yet.</p></b:if>
              <nav aria-label='Post pagination' class='gc-paging'>
                <b:if cond='data:newerPageUrl'><a expr:href='data:newerPageUrl'>← Newer posts</a></b:if>
                <b:if cond='data:olderPageUrl'><a expr:href='data:olderPageUrl'>Older posts →</a></b:if>
              </nav>
            </section>
          </b:if>
        </b:includable>
        <b:includable id='collectionLabels' var='post'>
          <div class='gc-tags'>
            <b:loop values='data:post.labels' var='label'>
              <a expr:href='data:label.url'><data:label.name/></a>
            </b:loop>
          </div>
        </b:includable>
        <b:includable id='collectionComments' var='post'>
          <section aria-label='Comments' class='gc-comments' id='comments'>
            <h2>Comments</h2>
            <b:loop values='data:post.comments' var='comment'>
              <div class='gc-comment'>
                <strong><data:comment.author/></strong>
                <p class='gc-byline'><data:comment.timestamp/></p>
                <div><data:comment.body/></div>
              </div>
            </b:loop>
            <b:if cond='data:post.addCommentUrl'>
              <a class='gc-action' expr:href='data:post.addCommentUrl'>Leave a comment</a>
            </b:if>
          </section>
        </b:includable>
      </b:widget>
    </b:section>
  </main>
  <footer class='gc-footer'>
    <div class='gc-wrap'>
      <div class='gc-blog-gadgets'>
        <b:section class='footer' id='footer' showaddelement='yes'>
          <b:widget id='PageList1' locked='no' mobile='yes' title='Pages' type='PageList' version='1'/>
          <b:widget id='Label1' locked='no' mobile='yes' title='Topics' type='Label' version='1'/>
          <b:widget id='BlogArchive1' locked='no' mobile='yes' title='Archive' type='BlogArchive' version='1'/>
        </b:section>
      </div>
      <div class='gc-blog-credit'>Powered by <a href='https://gonk.fun/' rel='nofollow'>gonk.fun</a></div>
    </div>
  </footer>
</body>
</html>
